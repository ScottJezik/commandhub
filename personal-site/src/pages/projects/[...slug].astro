---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }))
}

const { project } = Astro.props
const { Content } = await render(project)
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---
<BaseLayout title={`${project.data.title} — Scott Jezik`} description={project.data.description} canonical={`https://scottjezik.com/projects/${project.id}/`}>
  <main class="article-page shell">
    <a class="back-link" href={`${base}#work`}>← Back to work</a>
    <p class="article-category">{project.data.status}</p>
    <h1>{project.data.title}</h1>
    <p class="article-dek">{project.data.description}</p>
    <div class="article-tags">{project.data.tags.map(tag => <span>{tag}</span>)}</div>
    <article class="article-body"><Content /></article>
  </main>
</BaseLayout>
