---
import '../styles.css'

const { title = 'Scott Jezik — Technology, society, and progress', description = 'Scott Jezik explores how engineering, technology, human behavior, and institutions interact to shape the world.', canonical = 'https://scottjezik.com/' } = Astro.props
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Scott Jezik',
      url: 'https://scottjezik.com/',
      email: 'mailto:scottjezik@gmail.com',
      jobTitle: 'Interdisciplinary engineering communicator',
      sameAs: ['https://www.instagram.com/scottjezik/'],
    })} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={`${base}#top`} aria-label="Scott Jezik home"><span class="mark">SJ</span><span>Scott Jezik</span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav" aria-label="Main navigation">
        <a href={`${base}#work`}>Work</a>
        <a href={`${base}#writing`}>Writing</a>
        <a href={`${base}#speaking`}>Speaking</a>
        <a href={`${base}#cv`}>CV</a>
        <a class="nav-contact" href="mailto:scottjezik@gmail.com">Get in touch <span>↗</span></a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer shell"><span>© {new Date().getFullYear()} Scott Jezik</span><div><a href="https://www.instagram.com/scottjezik/" target="_blank" rel="noreferrer">Instagram ↗</a><a href="mailto:scottjezik@gmail.com">Email ↗</a></div></footer>
    <script>
      const menuToggle = document.querySelector('.menu-toggle')
      const siteNav = document.querySelector('.site-nav')
      menuToggle?.addEventListener('click', () => {
        const isOpen = siteNav.classList.toggle('open')
        menuToggle.setAttribute('aria-expanded', String(isOpen))
      })
      siteNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        siteNav.classList.remove('open')
        menuToggle?.setAttribute('aria-expanded', 'false')
      }))
    </script>
  </body>
</html>
